# Local stabilization template. Use only keys printed by the local Supabase CLI.
# Never copy production credentials into this file or local fixtures.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_DATA_API_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider Architecture (Text Generation: Groq primary, xAI secondary, Gemini fallback)
# Active provider: "groq" | "xai" | "gemini" (defaults to "groq" when GROQ_API_KEY is present)
AI_PROVIDER=groq
AI_ENABLE_FALLBACK=false

# Provider A: Groq (Primary Text Generation)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Provider B: xAI Grok (Secondary / Alternative Text Generation)
XAI_API_KEY=
XAI_MODEL=grok-2-1212
XAI_API_URL=https://api.x.ai/v1/chat/completions

# Provider C: Google Gemini (Embeddings & OCR Multimodal, plus text generation fallback)
# Server-only. Leave blank for local provider-mocked tests.
# Preserved for 768-dim embeddings (gemini-embedding-001) and OCR extraction (gemini-2.5-flash)
GEMINI_API_KEY=

# Resend Email Configuration (Custom Domain SMTP & Webhooks)
RESEND_API_KEY=
RESEND_EMAILS_API_KEY=
RESEND_WEBHOOK_SECRET=

ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_API_KEY=
ELASTIC_SEARCH_API_KEY=

LERNA_TEST_MODE=local
LERNA_E2E_BASE_URL=http://127.0.0.1:3100
LERNA_MAILBOX_URL=http://127.0.0.1:54324
ACTIVITY_ENVIRONMENT=local
ACTIVITY_RELEASE_ID=local-stabilization
# Generate separate random server-only values of at least 32 characters.
MAINTENANCE_JOB_TOKEN=
ACTIVITY_READ_TOKEN=
